# Copy to .env and fill in. Never commit .env.
JWT_SECRET_KEY=change-me-run-python-c-import-secrets-print-secrets.token_urlsafe-48
# Free key: https://aistudio.google.com/apikey  (leave empty to use the offline intent parser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-flash-latest,gemini-3.1-flash-lite
# SQLite by default; e.g. mysql+pymysql://user:pass@localhost:3306/moneymate
# DATABASE_URL=sqlite:///./moneymate.db
CORS_ORIGINS=http://localhost:3000
DEMO_USER_PASSWORD=Demo@2026
# "production" blocks simulated dates on POST /api/monitor/run and requires VERIFICATION_MODE=device
ENVIRONMENT=development

# Payment verification. There is no auto-payment: every movement of money waits for the student.
# device  = the Android phone signs a one-time challenge with a Keystore key unlocked by fingerprint / face unlock (default)
# sandbox = also accepts {"sandbox": true} instead of a signature; ONLY for demos through /docs
#           (the server refuses to start with sandbox when ENVIRONMENT=production)
VERIFICATION_MODE=device
# Minutes a payment the student started can be verified; hours for one prepared by the daily monitor
CONFIRMATION_TTL_MINUTES=15
SCHEDULED_TTL_HOURS=24

# Daily monitor: deadlines, standing instructions, money from new senders, low balance
MONITOR_ENABLED=true
# Hour of day (server local time) when the monitor runs
MONITOR_HOUR=8
# Push to the Android app through Firebase Cloud Messaging (HTTP v1). Best effort; in-app notifications always work.
PUSH_ENABLED=false
# Firebase console > Project settings > General > Project ID
FCM_PROJECT_ID=
# Path to the Firebase service-account JSON (Project settings > Service accounts > Generate new private key).
# It is a secret: keep it outside the repository or name it *service-account*.json (git-ignored).
FCM_SERVICE_ACCOUNT_FILE=

# Live mid-market FX rates (set false to use the offline snapshot)
FX_LIVE=true
# Receipt verification codes; defaults to a key derived from JWT_SECRET_KEY. Keep it stable.
RECEIPT_SIGNING_KEY=
PUBLIC_BASE_URL=http://localhost:8000
