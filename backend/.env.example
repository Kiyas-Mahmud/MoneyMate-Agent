# Copy to .env and fill in. Never commit .env.
JWT_SECRET_KEY=change-me-run-python-c-import-secrets-print-secrets.token_urlsafe-48
# Free key: https://aistudio.google.com/apikey  (leave empty to use the offline intent parser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# SQLite by default; e.g. mysql+pymysql://user:pass@localhost:3306/moneymate
# DATABASE_URL=sqlite:///./moneymate.db
CORS_ORIGINS=http://localhost:3000
DEMO_USER_PASSWORD=Demo@2026
# "production" blocks simulated dates on POST /api/monitor/run
ENVIRONMENT=development

# Payment verification. There is no auto-payment: every movement of money waits for the student.
# device  = the phone signs a one-time challenge with a key unlocked by Face ID / fingerprint (default)
# sandbox = also accepts {"sandbox": true} instead of a signature; ONLY for demos through /docs, never in production
VERIFICATION_MODE=device
# Minutes a payment the student started can be verified; hours for one prepared by the daily monitor
CONFIRMATION_TTL_MINUTES=15
SCHEDULED_TTL_HOURS=24

# Daily monitor: deadlines, standing instructions, money from new senders, low balance
MONITOR_ENABLED=true
# Hour of day (server local time) when the monitor runs
MONITOR_HOUR=8
# Push to the phone through the Expo push service (best effort; in-app notifications always work)
PUSH_ENABLED=false
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Live mid-market FX rates (set false to use the offline snapshot)
FX_LIVE=true
# Receipt verification codes; defaults to a key derived from JWT_SECRET_KEY. Keep it stable.
RECEIPT_SIGNING_KEY=
PUBLIC_BASE_URL=http://localhost:8000
